# 실제 파일명은 keystore.properties 로 복사해서 사용한다. (git에 커밋 금지)
# 키스토어 생성:
#   keytool -genkeypair -v -keystore aos.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# 키스토어를 분실하면 해당 앱은 영원히 업데이트가 불가능하다. 반드시 별도 백업할 것.

storeFile=aos.jks
storePassword=
keyAlias=upload
keyPassword=

# 배포 자동화(triplet play) 사용 시
playServiceAccountJson=play-account.json
